# ─────────────────────────────────────────────────────────────
# /blockchain .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Alchemy RPC API Key (https://dashboard.alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Polygon wallet private key (no 0x prefix needed by some tools, but safe to include)
# ⚠️  WARNING: This key controls real funds on mainnet. Handle with extreme care.
POLYGON_PRIVATE_KEY=your_wallet_private_key_here

# Polygonscan API Key for contract verification (https://polygonscan.com/myapikey)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
