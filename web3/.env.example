# ─────────────────────────────────────────────────────────────
# /web3 .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Alchemy (Blockchain RPC) ──────────────────────────────────
# Get your key at: https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ── Polygon Wallet ────────────────────────────────────────────
# The private key of the wallet that will sign anchor transactions.
# ⚠️  WARNING: This wallet must hold MATIC for gas fees.
# ⚠️  NEVER share or commit this key.
POLYGON_PRIVATE_KEY=your_wallet_private_key_here

# ── Deployed Contract ─────────────────────────────────────────
# Set this after deploying ContractVault.sol via /blockchain/scripts/deploy.js
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# ── Network Selection ─────────────────────────────────────────
# Options: polygonAmoy (testnet) | polygon (mainnet)
NETWORK=polygonAmoy

# ── Pinata (IPFS) ─────────────────────────────────────────────
# Get your keys at: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_api_key_here
